{
  "name": "niri-notch-rs-video",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion promo video for niri-notch-rs",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "preview": "remotion preview src/index.ts",
