    "remotion": "4.0.478",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
