# Maintainer: mud <mud@example.invalid>
pkgname=niri-notch-rs
pkgver=0.1.0
pkgrel=1
pkgdesc='Animated Dynamic Island-style companion notch for the Niri Wayland compositor'
arch=('x86_64')
url='https://github.com/mud-the-developer/niri-notch-rs'
license=('MIT')
depends=('gtk3' 'gtk-layer-shell' 'niri' 'waybar' 'mako' 'playerctl')
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::https://github.com/mud-the-developer/$pkgname/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/niri-notch-rs" "$pkgdir/usr/bin/niri-notch-rs"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
